{
  "name": "nexra",
  "version": "0.1.0",
  "description": "Nexra.sh — AI security engagement console",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "electron-rebuild --only better-sqlite3 --force && npm run copy:scripts",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && tsc -p tsconfig.node.json && vite build && npm run copy:scripts",
    "copy:scripts": "node scripts/copy-assets.cjs",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "predist": "electron-rebuild --only better-sqlite3 --force",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/fix-native-permissions.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.11.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.116",
    "@ai-sdk/openai-compatible": "^2.0.74",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.277",
    "better-sqlite3": "^12.11.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "author": "EthanChamps"
}
