{
  "name": "nexra",
  "version": "0.1.0",
  "description": "Nexra.sh — AI security engagement console",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "electron-rebuild --only better-sqlite3",
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "predist": "electron-rebuild --only better-sqlite3",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/fix-native-permissions.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.5",
    "@ai-sdk/openai-compatible": "^3.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^5.0.209",
    "better-sqlite3": "^12.11.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
